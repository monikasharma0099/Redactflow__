# RedactFlow v2 backend configuration
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Detection layers
ENABLE_SPACY=true
ENABLE_LLM=false
SPACY_MODEL=en_core_web_sm

# LLM (Ollama) — only used when ENABLE_LLM=true.
# WARNING: enabling this sends extracted document text to OLLAMA_HOST.
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT=30

# OCR (EasyOCR reader is created lazily on first request)
OCR_LANGUAGES=["en"]
OCR_GPU=false

# Limits
MAX_FILE_SIZE=10485760
MAX_PDF_PAGES=25
BATCH_MAX_FILES=20

# Persistence (SQLite at DATA_DIR/redactflow.db, artifacts in DATA_DIR/storage)
DATA_DIR=./data
JOB_TTL_DAYS=7

# Optional API key auth: when set, all /api/v1 endpoints except /health
# require the X-API-Key header. Leave empty for open access.
# API_KEY=

# Masking
DEFAULT_MASK_TYPE=blur

# Synthetic data locale
SYNTHETIC_LOCALE=en_IN
